 	humanize "github.com/dustin/go-humanize"
 	lua "github.com/yuin/gopher-lua"
+	json "layeh.com/gopher-json"
 	luar "layeh.com/gopher-luar"
 )
 
@@ -76,6 +77,8 @@ func Import(pkg string) *lua.LTable {
 		return importHumanize()
 	case "net/http", "http":
 		return importHTTP()
+	case "encoding/json", "json":
+		return importJson()
 	case "archive/zip":
 		return importArchiveZip()
 	default:
@@ -601,3 +604,30 @@ func importArchiveZip() *lua.LTable {
 
 	return pkg
 }
+
+func importJson() *lua.LTable {
+	pkg := L.NewTable()
+	L.SetField(pkg, "decode", L.NewFunction(func(L *lua.LState) int {
+		str := L.CheckString(1)
+		val, err := json.Decode(L, []byte(str))
+		if err != nil {
+			L.Push(lua.LNil)
+			L.Push(lua.LString(err.Error()))
+			return 2
+		}
+		L.Push(val)
+		return 1
+	}))
+	L.SetField(pkg, "encode", L.NewFunction(func(L *lua.LState) int {
+		val := L.CheckAny(1)
+		data, err := json.Encode(val)
+		if err != nil {
+			L.Push(lua.LNil)
+			L.Push(lua.LString(err.Error()))
+			return 2
+		}
+		L.Push(lua.LString(string(data)))
+		return 1
+	}))
+	return pkg
+}
diff --git a/internal/shell/http_stream.go b/internal/shell/http_stream.go
new file mode 100644
index 00000000..e4fda5fd
--- /dev/null
+++ b/internal/shell/http_stream.go
@@ -0,0 +1,60 @@
+package shell
+
+import (
+	"bufio"
+	"context"
+	"net/http"
+	"strings"
+)
+
+type StreamJob struct {
+	cancel context.CancelFunc
+}
+
+func (s *StreamJob) Cancel() {
+	s.cancel()
+}
+
+// HttpStream starts an HTTP request in the background and streams the response line by line to the callback
+func HttpStream(method, url string, body string, headers []string, onData func(string, []any), userargs ...any) *StreamJob {
+	ctx, cancel := context.WithCancel(context.Background())
+	sj := &StreamJob{cancel}
+
+	go func() {
+		req, err := http.NewRequestWithContext(ctx, method, url, strings.NewReader(body))
+		if err != nil {
+			if onData != nil {
+				Jobs <- JobFunction{onData, "error: " + err.Error(), userargs}
+			}
+			return
+		}
+		for i := 0; i < len(headers); i += 2 {
+			req.Header.Add(headers[i], headers[i+1])
+		}
+
+		client := &http.Client{Timeout: 0}
+		resp, err := client.Do(req)
+		if err != nil {
+			if onData != nil {
+				Jobs <- JobFunction{onData, "error: " + err.Error(), userargs}
+			}
+			return
+		}
+		defer resp.Body.Close()
+
+		reader := bufio.NewScanner(resp.Body)
+		for reader.Scan() {
+			line := reader.Text()
+			if onData != nil {
+				Jobs <- JobFunction{onData, line, userargs}
+			}
+		}
+		if err := reader.Err(); err != nil {
+			if onData != nil {
+				Jobs <- JobFunction{onData, "error: " + err.Error(), userargs}
+			}
+		}
+	}()
+
+	return sj
+}
