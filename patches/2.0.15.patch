+	VirtualText string
+	// VirtualTextLoc stores where the ghost text begins
+	VirtualTextLoc Loc
+}
+
+// SetVirtualText sets the virtual text and its starting location.
+func (b *Buffer) SetVirtualText(text string) {
+	b.VirtualText = text
+	b.VirtualTextLoc = b.GetActiveCursor().Loc
