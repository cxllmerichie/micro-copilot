diff --git a/internal/display/virtual.go b/internal/display/virtual.go
new file mode 100644
index 00000000..5c6f6153
--- /dev/null
+++ b/internal/display/virtual.go
@@ -0,0 +1,70 @@
+package display
+
+import (
+	"strings"
+
+	"github.com/mattn/go-runewidth"
+	"github.com/micro-editor/tcell/v2"
+
+	"github.com/zyedidia/micro/v2/internal/buffer"
+	"github.com/zyedidia/micro/v2/internal/config"
+)
+
+// drawVirtualText handles rendering of ghost text without modifying the actual buffer.
+func (w *BufWindow) drawVirtualText(text string, vloc *buffer.Loc, maxWidth int, softwrap bool,
+	draw func(r rune, combc []rune, style tcell.Style, highlight bool, showcursor bool, preservebg bool),
+	wrap func()) {
+
+	style := config.DefStyle.Foreground(tcell.ColorGray)
+	if s, ok := config.Colorscheme["virtual-text"]; ok {
+		style = s
+	}
+
+	if colorOpt := config.GetGlobalOption("copilot.text_color"); colorOpt != nil {
+		if colorStr, ok := colorOpt.(string); ok && colorStr != "" {
+			if parsedColor, valid := config.StringToColor(colorStr); valid {
+				style = config.DefStyle.Foreground(parsedColor)
+			}
+		}
+	}
+
+	lines := strings.Split(text, "\n")
+	for i, line := range lines {
+		for _, r := range line {
+			width := runewidth.RuneWidth(r)
+
+			// Wrap if necessary
+			if vloc.X+width > maxWidth && vloc.X > w.gutterOffset {
+				for vloc.X < maxWidth {
+					draw(' ', nil, config.DefStyle, false, false, true)
+				}
+				if softwrap {
+					vloc.Y++
+					if vloc.Y >= w.bufHeight {
+						break
+					}
+					wrap()
+				} else {
+					break
+				}
+			}
+
+			draw(r, nil, style, false, false, false)
+			// draw() increments vlocX
+			for j := 1; j < width; j++ {
+				draw(' ', nil, style, false, false, false)
+			}
+		}
+		if i < len(lines)-1 {
+			// Virtual newline
+			for vloc.X < maxWidth {
+				draw(' ', nil, config.DefStyle, false, false, true)
+			}
+			vloc.Y++
+			if vloc.Y >= w.bufHeight {
+				break
+			}
+			wrap()
+		}
+	}
+}
